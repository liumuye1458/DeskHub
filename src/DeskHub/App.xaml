<Application x:Class="DeskHub.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <!-- 配色取自 360 桌面助手皮肤包（360desktoplite_theme.xml / desktop_widget_bk.png） -->
      <FontFamily x:Key="UiFont">Microsoft YaHei UI, Microsoft YaHei, Segoe UI</FontFamily>
      <Color x:Key="GreenColor">#07C255</Color>
      <SolidColorBrush x:Key="Green" Color="#07C255"/>
      <SolidColorBrush x:Key="GreenHover" Color="#20D16A"/>
      <SolidColorBrush x:Key="GreenSoft" Color="#E9F8EF"/>
      <SolidColorBrush x:Key="Orange" Color="#E6FF992B"/>
      <SolidColorBrush x:Key="FenceBg" Color="#40000000"/>
      <SolidColorBrush x:Key="FenceBgCold" Color="#2E000000"/>
      <SolidColorBrush x:Key="FenceBorder" Color="#47FFFFFF"/>
      <SolidColorBrush x:Key="FenceLine" Color="#1FFFFFFF"/>
      <SolidColorBrush x:Key="TextMain" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="TextSub" Color="#CCCCCC"/>
      <SolidColorBrush x:Key="TextDim" Color="#999999"/>
      <SolidColorBrush x:Key="ItemHover" Color="#2EFFFFFF"/>
      <SolidColorBrush x:Key="ItemSelected" Color="#47FFFFFF"/>
      <SolidColorBrush x:Key="WinLine" Color="#E8E8E8"/>
      <SolidColorBrush x:Key="WinSoft" Color="#F5F6F7"/>
      <SolidColorBrush x:Key="WinText" Color="#333333"/>
      <SolidColorBrush x:Key="WinText2" Color="#666666"/>
      <SolidColorBrush x:Key="WinText3" Color="#999999"/>

      <DropShadowEffect x:Key="TextShadow" BlurRadius="3" ShadowDepth="1" Opacity="0.85" Color="Black" RenderingBias="Performance"/>

      <!-- 白底窗口里的按钮 -->
      <Style x:Key="BtnW" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#333"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#D9D9D9"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="b" Property="BorderBrush" Value="#07C255"/>
                  <Setter Property="Foreground" Value="#07C255"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="b" Property="Opacity" Value="0.5"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="BtnG" TargetType="Button" BasedOn="{StaticResource BtnW}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#07C255"/>
        <Setter Property="BorderBrush" Value="#07C255"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="b" Property="Background" Value="#20D16A"/>
                  <Setter TargetName="b" Property="BorderBrush" Value="#20D16A"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- 深色半透明底上的描边按钮 -->
      <Style x:Key="BtnL" TargetType="Button" BasedOn="{StaticResource BtnW}">
        <Setter Property="Foreground" Value="#EEE"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="#59FFFFFF"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="b" Property="Background" Value="#1FFFFFFF"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="WinTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="#333"/>
        <Setter Property="BorderBrush" Value="#DDDDDD"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style.Triggers>
          <Trigger Property="IsKeyboardFocused" Value="True">
            <Setter Property="BorderBrush" Value="#07C255"/>
          </Trigger>
        </Style.Triggers>
      </Style>

      <!-- 开关 -->
      <Style x:Key="Toggle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="CheckBox">
              <StackPanel Orientation="Horizontal" Background="Transparent">
                <Border x:Name="track" Width="34" Height="18" CornerRadius="9" Background="#CCCCCC" VerticalAlignment="Center">
                  <Ellipse x:Name="knob" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="2,0"/>
                </Border>
                <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="track" Property="Background" Value="#07C255"/>
                  <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- 设置窗口左侧导航 -->
      <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="#555"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <Border x:Name="b" CornerRadius="4" Padding="12,9" Background="Transparent">
                <ContentPresenter/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="b" Property="Background" Value="#ECEEF0"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="b" Property="Background" Value="White"/>
                  <Setter Property="Foreground" Value="#07C255"/>
                  <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- 细滚动条（分区内） -->
      <Style x:Key="ThinScroll" TargetType="ScrollBar">
        <Setter Property="Width" Value="6"/>
        <Setter Property="MinWidth" Value="6"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="3" Background="#59FFFFFF" Margin="1,2"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
