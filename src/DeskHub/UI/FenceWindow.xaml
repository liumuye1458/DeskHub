<Window x:Class="DeskHub.UI.FenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        FontFamily="{StaticResource UiFont}" FontSize="12" Foreground="White"
        AllowDrop="True" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="B2V"/>

    <DataTemplate x:Key="ItemTpl">
      <Border x:Name="cell" Width="76" Height="88" CornerRadius="6" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Margin="0,0,0,2"
              ToolTip="{Binding Tip}" ToolTipService.InitialShowDelay="700">
        <Grid>
          <StackPanel Margin="0,5,0,0">
            <Image Source="{Binding Icon}" Width="42" Height="42" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform"/>
            <TextBlock Text="{Binding Name}" Width="70" MaxHeight="30" Margin="0,5,0,0" TextAlignment="Center"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="15" LineStackingStrategy="BlockLineHeight"
                       Effect="{StaticResource TextShadowSoft}"/>
          </StackPanel>
          <Ellipse Width="8" Height="8" Fill="{StaticResource Green}" Stroke="#40000000" StrokeThickness="1"
                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,12,0"
                   Visibility="{Binding IsNew, Converter={StaticResource B2V}}"/>
          <Border Background="{StaticResource Orange}" CornerRadius="7" Padding="5,0" Height="15"
                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,3,0"
                  Visibility="{Binding HasBadge, Converter={StaticResource B2V}}">
            <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="White" VerticalAlignment="Center"/>
          </Border>
          <Path Data="M5,0 L9,4 L7.5,5.5 L8,9 L6.5,10.5 L4,8 L1,11 L0,11 L0,10 L3,7 L0.5,4.5 L2,3 L5.5,3.5 L7,2 Z"
                Fill="{StaticResource Green}" Stroke="White" StrokeThickness="0.6" Width="11" Height="11" Stretch="Uniform"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,6,0,0"
                Visibility="{Binding Pinned, Converter={StaticResource B2V}}"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="cell" Property="IsMouseOver" Value="True">
          <Setter TargetName="cell" Property="Background" Value="{StaticResource ItemHover}"/>
        </Trigger>
        <DataTrigger Binding="{Binding Selected}" Value="True">
          <Setter TargetName="cell" Property="Background" Value="{StaticResource ItemSelected}"/>
          <Setter TargetName="cell" Property="BorderBrush" Value="{StaticResource ItemSelectedLine}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding DropHover}" Value="True">
          <Setter TargetName="cell" Property="Background" Value="{StaticResource ItemSelected}"/>
          <Setter TargetName="cell" Property="BorderBrush" Value="{StaticResource ItemSelectedLine}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Faded}" Value="True">
          <Setter TargetName="cell" Property="Opacity" Value="0.55"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Border x:Name="Root" Background="{StaticResource FenceBg}" BorderBrush="{StaticResource FenceBorder}" BorderThickness="1" CornerRadius="6">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="36"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- 标题栏：按住拖动整个分区。不画分隔线，靠留白分开（和 Windows 11 的卡片一样） -->
      <Border x:Name="Header" Grid.Row="0" Background="#01000000" Cursor="SizeAll">
        <DockPanel Margin="14,0,6,0">
          <Button x:Name="MenuBtn" DockPanel.Dock="Right" Width="28" Height="28" Cursor="Hand" ToolTip="分区菜单" Focusable="False">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="b" Background="Transparent" CornerRadius="14">
                  <Path Data="{StaticResource MoreDots}" Fill="White" Opacity="0.85" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource SoftOn}"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
          <TextBlock x:Name="HintText" DockPanel.Dock="Right" Foreground="{StaticResource TextHint}" Effect="{StaticResource TextShadowSoft}" FontSize="11.5" VerticalAlignment="Center" Margin="8,0,4,0" TextTrimming="CharacterEllipsis"/>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" FontSize="13.5" FontWeight="SemiBold" Effect="{StaticResource TextShadowSoft}"/>
            <TextBlock x:Name="CountText" Foreground="{StaticResource TextHint}" Effect="{StaticResource TextShadowSoft}" Margin="7,0,0,0" VerticalAlignment="Bottom" Padding="0,0,0,1"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- 事项标签页（只有"进行中"有）：圆角小药丸 -->
      <ItemsControl x:Name="Tabs" Grid.Row="1" Margin="10,0,10,0" Visibility="Collapsed">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border x:Name="t" CornerRadius="12" Padding="10,3,10,4" Margin="0,0,4,2" Background="Transparent" Cursor="Hand" AllowDrop="True" Tag="{Binding Name}">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="n" Text="{Binding Display}" Foreground="{StaticResource TextSub}" Effect="{StaticResource TextShadowSoft}"/>
                <TextBlock x:Name="c" Text="{Binding Count}" Foreground="{StaticResource TextHint}" Effect="{StaticResource TextShadowSoft}" Margin="5,0,0,0"/>
              </StackPanel>
            </Border>
            <DataTemplate.Triggers>
              <Trigger SourceName="t" Property="IsMouseOver" Value="True">
                <Setter TargetName="t" Property="Background" Value="{StaticResource SoftHover}"/>
                <Setter TargetName="n" Property="Foreground" Value="White"/>
              </Trigger>
              <DataTrigger Binding="{Binding On}" Value="True">
                <Setter TargetName="t" Property="Background" Value="{StaticResource SoftOn}"/>
                <Setter TargetName="n" Property="Foreground" Value="White"/>
                <Setter TargetName="c" Property="Foreground" Value="#D8D8D8"/>
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- 类型筛选 -->
      <ItemsControl x:Name="Chips" Grid.Row="2" Margin="12,4,12,0" Visibility="Collapsed">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border x:Name="c" CornerRadius="10" BorderThickness="1" BorderBrush="#2EFFFFFF" Padding="9,1,9,2" Margin="0,0,6,0" Cursor="Hand" Tag="{Binding Name}">
              <TextBlock x:Name="t" Text="{Binding Display}" FontSize="11" Foreground="{StaticResource TextSub}" Effect="{StaticResource TextShadowSoft}"/>
            </Border>
            <DataTemplate.Triggers>
              <Trigger SourceName="c" Property="IsMouseOver" Value="True">
                <Setter TargetName="c" Property="Background" Value="{StaticResource SoftHover}"/>
              </Trigger>
              <DataTrigger Binding="{Binding On}" Value="True">
                <Setter TargetName="c" Property="BorderBrush" Value="#B307C255"/>
                <Setter TargetName="c" Property="Background" Value="#4D07C255"/>
                <Setter TargetName="t" Property="Foreground" Value="White"/>
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <ScrollViewer x:Name="Scroll" Grid.Row="3" Margin="6,4,3,6" Background="#01000000" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <ScrollViewer.Resources>
          <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScroll}"/>
        </ScrollViewer.Resources>
        <Grid>
          <ItemsControl x:Name="Items" ItemTemplate="{StaticResource ItemTpl}" Focusable="False">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          </ItemsControl>
          <!-- 拖框多选的选框（跟着内容一起滚动） -->
          <Canvas IsHitTestVisible="False">
            <Rectangle x:Name="Band" Visibility="Collapsed" Fill="#2E07C255" Stroke="#D907C255" StrokeThickness="1" RadiusX="2" RadiusY="2"/>
          </Canvas>
        </Grid>
      </ScrollViewer>
      <TextBlock x:Name="EmptyText" Grid.Row="3" Foreground="{StaticResource TextHint}" Effect="{StaticResource TextShadowSoft}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

      <Border x:Name="Footer" Grid.Row="4" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0" Height="28" Visibility="Collapsed">
        <DockPanel Margin="14,0">
          <TextBlock x:Name="FooterLink" DockPanel.Dock="Right" Text="归档记录 / 撤回" Cursor="Hand" VerticalAlignment="Center" Foreground="White" Opacity="0.9" FontSize="11.5" Margin="10,0,0,0" Effect="{StaticResource TextShadowSoft}"/>
          <TextBlock x:Name="FooterText" Foreground="{StaticResource TextHint}" Effect="{StaticResource TextShadowSoft}" VerticalAlignment="Center" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
      </Border>

      <!-- 右下角拖动改大小 -->
      <Thumb x:Name="Grip" Grid.Row="3" Grid.RowSpan="2" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Margin="0,0,1,1">
        <Thumb.Template>
          <ControlTemplate TargetType="Thumb">
            <Grid Background="Transparent">
              <Path Data="M10,2 L2,10 M10,6 L6,10" Stroke="#66FFFFFF" StrokeThickness="1"/>
            </Grid>
          </ControlTemplate>
        </Thumb.Template>
      </Thumb>
    </Grid>
  </Border>
</Window>
