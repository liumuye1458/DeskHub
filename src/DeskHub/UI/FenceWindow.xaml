<Window x:Class="DeskHub.UI.FenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        FontFamily="{StaticResource UiFont}" FontSize="12" Foreground="White"
        AllowDrop="True" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="B2V"/>

    <DataTemplate x:Key="ItemTpl">
      <Border x:Name="cell" Width="76" Height="88" CornerRadius="4" Background="Transparent" Margin="0,0,0,2"
              ToolTip="{Binding Tip}" ToolTipService.InitialShowDelay="700">
        <Grid>
          <StackPanel Margin="0,6,0,0">
            <Image Source="{Binding Icon}" Width="42" Height="42" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform"/>
            <TextBlock Text="{Binding Name}" Width="72" MaxHeight="30" Margin="0,5,0,0" TextAlignment="Center"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="15" LineStackingStrategy="BlockLineHeight"
                       Effect="{StaticResource TextShadow}"/>
          </StackPanel>
          <Ellipse Width="8" Height="8" Fill="{StaticResource Green}" Stroke="#40000000" StrokeThickness="1"
                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,12,0"
                   Visibility="{Binding IsNew, Converter={StaticResource B2V}}"/>
          <Border Background="{StaticResource Orange}" CornerRadius="7" Padding="5,0" Height="15"
                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,3,0"
                  Visibility="{Binding HasBadge, Converter={StaticResource B2V}}">
            <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="White" VerticalAlignment="Center"/>
          </Border>
          <Path Data="M5,0 L9,4 L7.5,5.5 L8,9 L6.5,10.5 L4,8 L1,11 L0,11 L0,10 L3,7 L0.5,4.5 L2,3 L5.5,3.5 L7,2 Z"
                Fill="{StaticResource Green}" Stroke="White" StrokeThickness="0.6" Width="11" Height="11" Stretch="Uniform"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,6,0,0"
                Visibility="{Binding Pinned, Converter={StaticResource B2V}}"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="cell" Property="IsMouseOver" Value="True">
          <Setter TargetName="cell" Property="Background" Value="{StaticResource ItemHover}"/>
        </Trigger>
        <DataTrigger Binding="{Binding Selected}" Value="True">
          <Setter TargetName="cell" Property="Background" Value="{StaticResource ItemSelected}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Faded}" Value="True">
          <Setter TargetName="cell" Property="Opacity" Value="0.55"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Border x:Name="Root" Background="{StaticResource FenceBg}" BorderBrush="{StaticResource FenceBorder}" BorderThickness="1" CornerRadius="6">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="32"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- 标题栏：按住拖动整个分区 -->
      <Border x:Name="Header" Grid.Row="0" Background="#01000000" BorderBrush="{StaticResource FenceLine}" BorderThickness="0,0,0,1" Cursor="SizeAll">
        <DockPanel Margin="12,0,6,0">
          <Button x:Name="MenuBtn" DockPanel.Dock="Right" Width="24" Height="24" Cursor="Hand" ToolTip="分区菜单" Focusable="False">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="b" Background="Transparent" CornerRadius="3">
                  <Path Data="M0,0 H12 M0,4 H12 M0,8 H12" Stroke="White" StrokeThickness="1.3" Opacity="0.8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#26FFFFFF"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
          <TextBlock x:Name="HintText" DockPanel.Dock="Right" Foreground="{StaticResource TextSub}" VerticalAlignment="Center" Margin="8,0,6,0" TextTrimming="CharacterEllipsis"/>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" FontSize="13" FontWeight="Bold"/>
            <TextBlock x:Name="CountText" Foreground="{StaticResource TextSub}" Margin="8,0,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- 事项标签页（只有"进行中"有） -->
      <ItemsControl x:Name="Tabs" Grid.Row="1" Margin="8,6,8,0" Visibility="Collapsed">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border x:Name="t" CornerRadius="4,4,0,0" Padding="10,4" Margin="0,0,2,0" Background="#2E000000" Cursor="Hand" AllowDrop="True" Tag="{Binding Name}">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="n" Text="{Binding Display}" Foreground="{StaticResource TextSub}"/>
                <TextBlock x:Name="c" Text="{Binding Count}" Foreground="{StaticResource TextDim}" Margin="4,0,0,0"/>
              </StackPanel>
            </Border>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding On}" Value="True">
                <Setter TargetName="t" Property="Background" Value="#29FFFFFF"/>
                <Setter TargetName="n" Property="Foreground" Value="White"/>
                <Setter TargetName="c" Property="Foreground" Value="#D8D8D8"/>
              </DataTrigger>
              <Trigger SourceName="t" Property="IsMouseOver" Value="True">
                <Setter TargetName="n" Property="Foreground" Value="White"/>
              </Trigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- 类型筛选 -->
      <ItemsControl x:Name="Chips" Grid.Row="2" Margin="10,6,10,0" Visibility="Collapsed">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border x:Name="c" CornerRadius="9" BorderThickness="1" BorderBrush="#38FFFFFF" Padding="8,1" Margin="0,0,6,0" Cursor="Hand" Tag="{Binding Name}">
              <TextBlock x:Name="t" Text="{Binding Display}" FontSize="11" Foreground="{StaticResource TextSub}"/>
            </Border>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding On}" Value="True">
                <Setter TargetName="c" Property="BorderBrush" Value="{StaticResource Green}"/>
                <Setter TargetName="c" Property="Background" Value="#5907C255"/>
                <Setter TargetName="t" Property="Foreground" Value="White"/>
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <ScrollViewer x:Name="Scroll" Grid.Row="3" Margin="4,6,2,4" Background="#01000000" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <ScrollViewer.Resources>
          <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScroll}"/>
        </ScrollViewer.Resources>
        <Grid>
          <ItemsControl x:Name="Items" ItemTemplate="{StaticResource ItemTpl}" Focusable="False">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          </ItemsControl>
          <!-- 拖框多选的选框（跟着内容一起滚动） -->
          <Canvas IsHitTestVisible="False">
            <Rectangle x:Name="Band" Visibility="Collapsed" Fill="#2E07C255" Stroke="#D907C255" StrokeThickness="1" RadiusX="2" RadiusY="2"/>
          </Canvas>
        </Grid>
      </ScrollViewer>
      <TextBlock x:Name="EmptyText" Grid.Row="3" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

      <Border x:Name="Footer" Grid.Row="4" BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0" Height="26" Visibility="Collapsed">
        <DockPanel Margin="12,0">
          <TextBlock x:Name="FooterLink" DockPanel.Dock="Right" Text="归档记录 / 撤回" Cursor="Hand" VerticalAlignment="Center" Foreground="White" Opacity="0.9" FontSize="11.5"/>
          <TextBlock x:Name="FooterText" Foreground="{StaticResource TextSub}" VerticalAlignment="Center" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
      </Border>

      <!-- 右下角拖动改大小 -->
      <Thumb x:Name="Grip" Grid.Row="3" Grid.RowSpan="2" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Margin="0,0,1,1">
        <Thumb.Template>
          <ControlTemplate TargetType="Thumb">
            <Grid Background="Transparent">
              <Path Data="M10,2 L2,10 M10,6 L6,10" Stroke="#66FFFFFF" StrokeThickness="1"/>
            </Grid>
          </ControlTemplate>
        </Thumb.Template>
      </Thumb>
    </Grid>
  </Border>
</Window>
