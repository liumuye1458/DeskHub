<Window x:Class="DeskHub.UI.LearnToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" Topmost="True" SizeToContent="WidthAndHeight"
        FontFamily="{StaticResource UiFont}" FontSize="12.5" Foreground="White">
  <Border Background="#EB1E2026" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="10">
    <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35"/></Border.Effect>
    <StackPanel MaxWidth="420">
      <TextBlock x:Name="Line1" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
        <TextBlock Text="以后文件名包含" Foreground="#BBB" VerticalAlignment="Center"/>
        <TextBox x:Name="Keyword" Width="120" Margin="6,0" Padding="4,2" FontSize="12.5" Background="#26FFFFFF" Foreground="White"
                 BorderBrush="#4DFFFFFF" CaretBrush="White" VerticalContentAlignment="Center"/>
        <TextBlock x:Name="Line2" Foreground="#BBB" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
        <Button x:Name="Yes" Content="好，记住" Style="{StaticResource BtnG}" IsDefault="True"/>
        <Button x:Name="No" Content="只这一次" Style="{StaticResource BtnL}" Margin="8,0,0,0" IsCancel="True"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
