<UserControl x:Class="DeskHub.UI.Settings.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock x:Name="AboutName" FontSize="14" FontWeight="Bold" Foreground="#222"/>
    <TextBlock x:Name="VersionText" Foreground="#999" Margin="0,6,0,0"/>
    <TextBlock x:Name="Privacy" Foreground="#666" Margin="0,14,0,0" TextWrapping="Wrap" LineHeight="22"/>
    <TextBlock Foreground="#666" TextWrapping="Wrap" LineHeight="22">数据位置：<Run x:Name="DataDirRun"/></TextBlock>
    <Button x:Name="OpenData" Content="打开数据文件夹" Style="{StaticResource BtnW}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
  </StackPanel>
</UserControl>
