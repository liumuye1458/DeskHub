<UserControl x:Class="DeskHub.UI.Settings.ArchiveSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 自动归档（编译开关 FeatArchive）。归档过的文件在“移动记录”里撤回 -->
  <StackPanel>
    <DockPanel Margin="0,16,0,0">
      <TextBlock Text="归档位置" VerticalAlignment="Center" Width="70" Foreground="#555"/>
      <Button x:Name="Browse" DockPanel.Dock="Right" Content="更改…" Style="{StaticResource BtnW}" Margin="8,0,0,0"/>
      <TextBox x:Name="ArchiveRoot" Style="{StaticResource WinTextBox}" Height="30"/>
    </DockPanel>
    <TextBlock x:Name="ArchiveExample" Foreground="#999" FontSize="12" Margin="70,6,0,0"/>
    <CheckBox x:Name="AutoArchive" Style="{StaticResource Toggle}" Margin="0,14,0,0" Content="到期自动归档（关闭后只在冷却区提示，不移动文件）"/>
    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
      <Button x:Name="CheckNow" Content="立即检查归档" Style="{StaticResource BtnW}"/>
      <TextBlock Foreground="#999" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" Text="归档过的文件可以在“移动记录”里撤回"/>
    </StackPanel>
  </StackPanel>
</UserControl>
