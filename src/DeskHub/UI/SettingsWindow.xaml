<Window x:Class="DeskHub.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New B Desk · 设置" Width="940" Height="680" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource UiFont}" FontSize="13"
        Background="White" Foreground="#333" Icon="pack://application:,,,/Assets/app.ico"
        UseLayoutRounding="True">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="170"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.RowSpan="2" Background="{StaticResource WinSoft}" BorderBrush="{StaticResource WinLine}" BorderThickness="0,0,1,0">
      <StackPanel Margin="8">
        <RadioButton x:Name="NavRules" Style="{StaticResource NavItem}" GroupName="nav" Content="整理规则" IsChecked="True"/>
        <RadioButton x:Name="NavFlow" Style="{StaticResource NavItem}" GroupName="nav" Content="流转与归档"/>
        <RadioButton x:Name="NavKeys" Style="{StaticResource NavItem}" GroupName="nav" Content="快捷键"/>
        <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" GroupName="nav" Content="常规"/>
        <RadioButton x:Name="NavAi" Style="{StaticResource NavItem}" GroupName="nav" Content="智能识别"/>
        <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" GroupName="nav" Content="关于"/>
      </StackPanel>
    </Border>

    <!-- ========== 整理规则 ========== -->
    <ScrollViewer x:Name="PageRules" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="26,18">
      <StackPanel>
        <TextBlock FontSize="14" FontWeight="Bold" Foreground="#222">事项规则</TextBlock>
        <TextBlock Foreground="#999" FontSize="12" Margin="0,4,0,12" TextWrapping="Wrap">
          文件名里包含关键词，就归进对应事项；一个都不包含的放进“其他”。关键词用逗号分开，不区分大小写。
          绿色区域是你拖动文件时教会它的，也可以直接改。
        </TextBlock>
        <StackPanel x:Name="RuleRows"/>
        <Button x:Name="AddTopic" Content="＋ 新增事项" Style="{StaticResource BtnW}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
      </StackPanel>
    </ScrollViewer>

    <!-- ========== 流转与归档 ========== -->
    <ScrollViewer x:Name="PageFlow" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="26,18" Visibility="Collapsed">
      <StackPanel>
        <TextBlock FontSize="14" FontWeight="Bold" Foreground="#222">文件怎么流转</TextBlock>
        <WrapPanel Margin="0,12,0,0">
          <Border BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="6" Padding="14,8" MinWidth="110">
            <StackPanel><TextBlock Text="今天" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="当天放上桌面" Foreground="#999" FontSize="12" HorizontalAlignment="Center"/></StackPanel>
          </Border>
          <TextBlock Text="→" Foreground="#BBB" VerticalAlignment="Center" Margin="8,0"/>
          <Border BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="6" Padding="14,8" MinWidth="110">
            <StackPanel><TextBlock Text="进行中" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="按事项分" Foreground="#999" FontSize="12" HorizontalAlignment="Center"/></StackPanel>
          </Border>
          <TextBlock Text="→" Foreground="#BBB" VerticalAlignment="Center" Margin="8,0"/>
          <Border BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="6" Padding="14,8" MinWidth="110">
            <StackPanel>
              <TextBlock Text="冷却区" FontWeight="Bold" HorizontalAlignment="Center"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                <TextBox x:Name="ColdDays" Width="40" TextAlignment="Center" Style="{StaticResource WinTextBox}" Padding="2,1" Foreground="#07C255" FontWeight="Bold"/>
                <TextBlock Text=" 天没碰" Foreground="#999" FontSize="12" VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <TextBlock Text="→" Foreground="#BBB" VerticalAlignment="Center" Margin="8,0"/>
          <Border BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="6" Padding="14,8" MinWidth="110">
            <StackPanel>
              <TextBlock Text="归档" FontWeight="Bold" HorizontalAlignment="Center"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                <TextBox x:Name="ArchiveDays" Width="40" TextAlignment="Center" Style="{StaticResource WinTextBox}" Padding="2,1" Foreground="#07C255" FontWeight="Bold"/>
                <TextBlock Text=" 天没碰" Foreground="#999" FontSize="12" VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </WrapPanel>
        <TextBlock Foreground="#999" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap">“碰过”指修改过、打开过（用任何程序打开都算），或刚放上桌面。快捷方式、文件夹、钉住的文件、公用桌面上的文件不参与流转。</TextBlock>

        <DockPanel Margin="0,16,0,0">
          <TextBlock Text="归档位置" VerticalAlignment="Center" Width="70" Foreground="#555"/>
          <Button x:Name="Browse" DockPanel.Dock="Right" Content="更改…" Style="{StaticResource BtnW}" Margin="8,0,0,0"/>
          <TextBox x:Name="ArchiveRoot" Style="{StaticResource WinTextBox}" Height="30"/>
        </DockPanel>
        <TextBlock x:Name="ArchiveExample" Foreground="#999" FontSize="12" Margin="70,6,0,0"/>
        <CheckBox x:Name="AutoArchive" Style="{StaticResource Toggle}" Margin="0,14,0,0" Content="到期自动归档（关闭后只在冷却区提示，不移动文件）"/>

        <DockPanel Margin="0,24,0,8">
          <Button x:Name="CheckNow" DockPanel.Dock="Right" Content="立即检查归档" Style="{StaticResource BtnW}"/>
          <TextBlock FontSize="14" FontWeight="Bold" Foreground="#222" VerticalAlignment="Center">归档记录</TextBlock>
        </DockPanel>
        <TextBlock x:Name="LogEmpty" Text="还没有归档过文件" Foreground="#AAA" Margin="0,4"/>
        <StackPanel x:Name="LogRows"/>
      </StackPanel>
    </ScrollViewer>

    <!-- ========== 快捷键 ========== -->
    <ScrollViewer x:Name="PageKeys" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="26,18" Visibility="Collapsed">
      <StackPanel>
        <TextBlock FontSize="14" FontWeight="Bold" Foreground="#222">快捷键</TextBlock>
        <TextBlock Foreground="#999" FontSize="12" Margin="0,4,0,12" TextWrapping="Wrap">点一下右边的框，然后直接按下新的组合键；按 Backspace 清除（不用快捷键）。被别的程序占用的组合会标红提示。</TextBlock>
        <StackPanel x:Name="KeyRows"/>
        <TextBlock x:Name="IndexInfo" Foreground="#999" FontSize="12" Margin="0,18,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>

    <!-- ========== 常规 ========== -->
    <ScrollViewer x:Name="PageGeneral" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="26,18" Visibility="Collapsed">
      <StackPanel>
        <TextBlock FontSize="14" FontWeight="Bold" Foreground="#222" Margin="0,0,0,10">常规</TextBlock>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
          <TextBlock Text="界面语言" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <ComboBox x:Name="LangBox" Width="220" Height="28" VerticalContentAlignment="Center"/>
          <TextBlock x:Name="LangHint" Foreground="#999" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" Text="改了以后重启生效"/>
        </StackPanel>
        <CheckBox x:Name="HideIcons" Style="{StaticResource Toggle}" Margin="0,8" Content="隐藏系统自带的桌面图标（由分区来显示；退出本工具后自动恢复）"/>
        <CheckBox x:Name="AutoStart" Style="{StaticResource Toggle}" Margin="0,8" Content="开机自动启动"/>
        <CheckBox x:Name="ShowSeconds" Style="{StaticResource Toggle}" Margin="0,8" Content="时钟显示秒（会每秒刷新一次）"/>
        <StackPanel Orientation="Horizontal" Margin="0,8">
          <TextBlock Text="时钟下面的一行字" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <TextBox x:Name="ClockNote" Width="300" Height="28" MaxLength="40" VerticalContentAlignment="Center" Style="{StaticResource WinTextBox}"/>
        </StackPanel>
        <TextBlock Foreground="#999" FontSize="12" Margin="0,0,0,0" TextWrapping="Wrap" Text="例如店名、直播间口号。空着就不显示；最长和上面的时区那一行一样宽，超出的显示省略号。"/>
        <TextBlock Foreground="#999" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap">时钟的时区和 12/24 小时制跟随 Windows 设置（设置 → 时间和语言），在那里改了会立刻生效。</TextBlock>
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
          <TextBlock Text="桌面块的底色" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <Button x:Name="LookBtn" Content="调底色深浅…" Style="{StaticResource BtnW}"/>
        </StackPanel>
        <TextBlock Foreground="#999" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" Text="分区、日历、工具条的半透明底色，拖动时桌面上马上变。按壁纸各记一份，换回调过的壁纸自动恢复。也可以在分区或日历的标题栏上按住 Ctrl 滚滚轮，或者右键 →“底色深浅…”，还能单独调某一块。"/>

        <TextBlock FontSize="14" FontWeight="Bold" Foreground="#222" Margin="0,24,0,4">日历</TextBlock>
        <TextBlock Foreground="#999" FontSize="12" TextWrapping="Wrap" Text="日历常驻在桌面上，和分区一样按住标题栏拖、右下角拉大小；拉宽会在右边列出接下来的行程。工具条上的“日历”（或你设的快捷键）可以隐藏 / 再显示。"/>
        <CheckBox x:Name="CalShow" Style="{StaticResource Toggle}" Margin="0,12,0,4" Content="在桌面上显示日历"/>
        <CheckBox x:Name="CalLunar" Style="{StaticResource Toggle}" Margin="0,8,0,4" Content="显示农历（含节气、春节中秋等传统节日）"/>
        <CheckBox x:Name="CalChina" Style="{StaticResource Toggle}" Margin="0,10,0,2" Content="显示中国节假日（放假标“休”，调休上班标“班”）"/>
        <TextBlock x:Name="CalChinaHint" Foreground="#999" FontSize="12" Margin="44,0,0,0" TextWrapping="Wrap"/>
        <CheckBox x:Name="CalIndonesia" Style="{StaticResource Toggle}" Margin="0,10,0,2" Content="显示印尼红日子（整格标红：深红 = 法定假日，浅红 = 联合休假）"/>
        <TextBlock x:Name="CalIndonesiaHint" Foreground="#999" FontSize="12" Margin="44,0,0,0" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <TextBlock Text="一周从哪天开始" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <ComboBox x:Name="CalWeekStart" Width="120" Height="28" VerticalContentAlignment="Center">
            <ComboBoxItem Content="周一"/>
            <ComboBoxItem Content="周日"/>
          </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
          <Button x:Name="Layouts" Content="布局：保存 / 切换 / 导出 / 导入…" Style="{StaticResource BtnW}" Margin="0,0,10,0"/>
          <Button x:Name="ResetLayout" Content="恢复默认布局" Style="{StaticResource BtnW}"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- ========== 智能识别（AI 服务） ========== -->
    <ScrollViewer x:Name="PageAi" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="26,18" Visibility="Collapsed">
      <StackPanel>
        <TextBlock FontSize="14" FontWeight="Bold" Foreground="#222" Margin="0,0,0,6">智能识别日程</TextBlock>
        <TextBlock Foreground="#666" FontSize="12.5" TextWrapping="Wrap" LineHeight="20" Text="把飞猪 / 携程订单截图、聊天记录、订单短信拖到日历上（或在日历上按 Ctrl+V），自动找出哪天要干什么，确认后加进日历。"/>
        <TextBlock Foreground="#666" FontSize="12.5" TextWrapping="Wrap" LineHeight="20" Margin="0,6,0,0" Text="下面填一个“OpenAI 兼容格式”的 AI 服务就能用 AI 来看：公司一体机、OpenAI、Claude、DeepSeek、通义千问、Kimi、本机 Ollama 等都支持这种格式。地址空着就用本机识别（不联网，准确度一般）。"/>

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
          <TextBlock Text="常用服务" Width="70" VerticalAlignment="Center"/>
          <ComboBox x:Name="AiPreset" Width="260" Height="28" VerticalContentAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <TextBlock Text="地址" Width="70" VerticalAlignment="Center"/>
          <TextBox x:Name="AiUrl" Width="420" Height="28" VerticalContentAlignment="Center" Style="{StaticResource WinTextBox}"/>
        </StackPanel>
        <TextBlock x:Name="AiUrlHint" Foreground="#999" FontSize="12" Margin="70,4,0,0" TextWrapping="Wrap" Text="一般填到 /v1 为止，例如 http://192.168.1.10:11434/v1"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <TextBlock Text="密钥" Width="70" VerticalAlignment="Center"/>
          <PasswordBox x:Name="AiKey" Width="420" Height="28" VerticalContentAlignment="Center" Padding="6,0"/>
        </StackPanel>
        <TextBlock Foreground="#999" FontSize="12" Margin="70,4,0,0" TextWrapping="Wrap" Text="公司一体机、本机 Ollama 一般不用密钥，空着就行。密钥加密保存在本机，只有这台电脑的这个账户能解开。"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <TextBlock Text="模型" Width="70" VerticalAlignment="Center"/>
          <ComboBox x:Name="AiModel" Width="300" Height="28" IsEditable="True" VerticalContentAlignment="Center"/>
          <Button x:Name="AiTest" Content="测试连接 / 读取模型" Style="{StaticResource BtnW}" Margin="10,0,0,0"/>
        </StackPanel>
        <TextBlock x:Name="AiTestHint" Foreground="#999" FontSize="12" Margin="70,6,0,0" TextWrapping="Wrap" Text="能看图的模型（例如带 vision / vl 的）可以直接看截图；看不了图的，会先在本机把截图识成文字再交给它。"/>

        <TextBlock FontSize="13" FontWeight="Bold" Foreground="#222" Margin="0,22,0,4">本机 Claude</TextBlock>
        <TextBlock Foreground="#666" FontSize="12.5" TextWrapping="Wrap" LineHeight="20" Text="用这台电脑上已经登录的 Claude（claude 命令行）来识别，不用另买密钥。打开后本工具在本机开一个小服务，只有这台电脑上的程序连得上；自家别的程序也可以接它。"/>
        <CheckBox x:Name="LcOn" Style="{StaticResource Toggle}" Margin="0,10,0,4" Content="打开本机 Claude 服务"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <TextBlock Text="端口" Width="70" VerticalAlignment="Center"/>
          <TextBox x:Name="LcPort" Width="90" Height="28" VerticalContentAlignment="Center" Style="{StaticResource WinTextBox}"/>
          <TextBlock Foreground="#999" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" Text="只听 127.0.0.1，别的电脑连不上"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <TextBlock Text="口令" Width="70" VerticalAlignment="Center"/>
          <PasswordBox x:Name="LcToken" Width="300" Height="28" VerticalContentAlignment="Center" Padding="6,0"/>
        </StackPanel>
        <TextBlock Foreground="#999" FontSize="12" Margin="70,4,0,0" TextWrapping="Wrap" Text="自己定一串字，程序来问时要带上它。加密保存在本机。"/>
        <StackPanel Orientation="Horizontal" Margin="70,10,0,0">
          <Button x:Name="LcUse" Content="日历识别改用本机 Claude" Style="{StaticResource BtnW}"/>
          <Button x:Name="LcDoc" Content="接口说明" Style="{StaticResource BtnW}" Margin="10,0,0,0"/>
        </StackPanel>
        <TextBlock x:Name="LcHint" Foreground="#999" FontSize="12" Margin="70,6,0,0" TextWrapping="Wrap"/>

        <TextBlock FontSize="13" FontWeight="Bold" Foreground="#222" Margin="0,22,0,4">隐私</TextBlock>
        <TextBlock Foreground="#666" FontSize="12.5" TextWrapping="Wrap" LineHeight="20" Text="只有你点“识别”的时候，丢进来的文字和截图才会发给上面这个服务，平时不联网。用公司一体机或本机 Ollama，内容不出公司 / 不出电脑；用外面的服务，内容会发到对方服务器。"/>
      </StackPanel>
    </ScrollViewer>

    <!-- ========== 关于 ========== -->
    <StackPanel x:Name="PageAbout" Grid.Column="1" Margin="26,18" Visibility="Collapsed">
      <TextBlock FontSize="14" FontWeight="Bold" Foreground="#222">New B Desk</TextBlock>
      <TextBlock x:Name="VersionText" Foreground="#999" Margin="0,6,0,0"/>
      <TextBlock Foreground="#666" Margin="0,14,0,0" TextWrapping="Wrap" LineHeight="22">
        纯本机工具，不上报；只有你配了 AI 服务并点“识别”时，才会把那次的内容发给它。打开“本机 Claude 服务”后，只在本机 127.0.0.1 上等自家程序来问。<LineBreak/>
        数据位置：<Run x:Name="DataDirRun"/>
      </TextBlock>
      <Button x:Name="OpenData" Content="打开数据文件夹" Style="{StaticResource BtnW}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
    </StackPanel>

    <!-- 底部按钮 -->
    <Border Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource WinLine}" BorderThickness="0,1,0,0" Padding="20,10">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <TextBlock x:Name="SaveHint" Foreground="#E47600" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <Button x:Name="Cancel" Content="取消" Style="{StaticResource BtnW}" MinWidth="80" IsCancel="True"/>
        <Button x:Name="Save" Content="保存" Style="{StaticResource BtnG}" MinWidth="80" Margin="8,0,0,0"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
