<Window x:Class="DeskHub.UI.ClockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False" SizeToContent="WidthAndHeight"
        FontFamily="{StaticResource UiFont}" Foreground="White" Cursor="SizeAll"
        TextOptions.TextFormattingMode="Ideal">
  <StackPanel Background="#01000000" Effect="{StaticResource TextShadow}" Margin="4">
    <TextBlock x:Name="TimeText" FontSize="56" FontWeight="Light" FontFamily="Segoe UI Light, Microsoft YaHei UI Light, Microsoft YaHei UI"/>
    <TextBlock x:Name="DateText" FontSize="14" Margin="2,6,0,0" Foreground="#F2F2F2"/>
    <TextBlock x:Name="ZoneText" FontSize="11.5" Margin="2,4,0,0" Foreground="#C0FFFFFF"/>
  </StackPanel>
</Window>
