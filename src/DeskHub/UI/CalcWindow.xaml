<Window x:Class="DeskHub.UI.CalcWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="计算器" Width="328" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <Style x:Key="Key" TargetType="Button">
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="Foreground" Value="#333"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="#F0F0F0" BorderThickness="0,0,1,1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#F5F6F7"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#E9ECEF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Fn" TargetType="Button" BasedOn="{StaticResource Key}">
      <Setter Property="Foreground" Value="#07C255"/>
    </Style>
    <Style x:Key="Eq" TargetType="Button" BasedOn="{StaticResource Key}">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#07C255"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#20D16A"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Margin="12" Background="White" CornerRadius="6" BorderBrush="#E3E3E3" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.25" RenderingBias="Performance"/>
    </Border.Effect>
    <StackPanel>
      <!-- 标题栏：拖动移动 -->
      <DockPanel x:Name="TitleBar" Height="36" Background="Transparent">
        <Button x:Name="CloseBtn" DockPanel.Dock="Right" Width="36" Style="{StaticResource Key}" FontSize="13" Foreground="#888" Content="✕" ToolTip="关闭（Esc）" Background="Transparent"/>
        <Button x:Name="MinBtn" DockPanel.Dock="Right" Width="36" Style="{StaticResource Key}" FontSize="13" Foreground="#888" Content="─" ToolTip="收起" Background="Transparent"/>
        <TextBlock Text="计算器" FontWeight="SemiBold" Foreground="#333" VerticalAlignment="Center" Margin="14,0,0,0"/>
      </DockPanel>

      <!-- 显示区 -->
      <Border Background="#FAFAFA" BorderBrush="#F0F0F0" BorderThickness="0,1,0,1" Padding="14,8,14,10">
        <StackPanel>
          <ItemsControl x:Name="History" HorizontalAlignment="Right" MaxHeight="64">
            <ItemsControl.Template>
              <ControlTemplate><ScrollViewer VerticalScrollBarVisibility="Hidden" x:Name="sv"><ItemsPresenter/></ScrollViewer></ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Foreground="#999" FontSize="12" HorizontalAlignment="Right" Cursor="Hand" ToolTip="点击把结果放回算式" Margin="0,1"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBox x:Name="Expr" BorderThickness="0" Background="Transparent" FontSize="15" Foreground="#555" TextAlignment="Right" Margin="0,4,0,0"/>
          <TextBlock x:Name="Result" FontSize="30" Foreground="#222" HorizontalAlignment="Right" Cursor="Hand" ToolTip="点击复制" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Border>

      <!-- 按键 -->
      <UniformGrid x:Name="Keys" Columns="4" Rows="5" Height="236">
        <Button Style="{StaticResource Fn}" Content="C" Tag="C"/>
        <Button Style="{StaticResource Fn}" Content="(" Tag="("/>
        <Button Style="{StaticResource Fn}" Content=")" Tag=")"/>
        <Button Style="{StaticResource Fn}" Content="÷" Tag="/"/>
        <Button Style="{StaticResource Key}" Content="7" Tag="7"/>
        <Button Style="{StaticResource Key}" Content="8" Tag="8"/>
        <Button Style="{StaticResource Key}" Content="9" Tag="9"/>
        <Button Style="{StaticResource Fn}" Content="×" Tag="*"/>
        <Button Style="{StaticResource Key}" Content="4" Tag="4"/>
        <Button Style="{StaticResource Key}" Content="5" Tag="5"/>
        <Button Style="{StaticResource Key}" Content="6" Tag="6"/>
        <Button Style="{StaticResource Fn}" Content="−" Tag="-"/>
        <Button Style="{StaticResource Key}" Content="1" Tag="1"/>
        <Button Style="{StaticResource Key}" Content="2" Tag="2"/>
        <Button Style="{StaticResource Key}" Content="3" Tag="3"/>
        <Button Style="{StaticResource Fn}" Content="+" Tag="+"/>
        <Button Style="{StaticResource Fn}" Content="%" Tag="%"/>
        <Button Style="{StaticResource Key}" Content="0" Tag="0"/>
        <Button Style="{StaticResource Key}" Content="." Tag="."/>
        <Button Style="{StaticResource Eq}" Content="=" Tag="="/>
      </UniformGrid>

      <TextBlock x:Name="Tip" Text="支持键盘直接输入 · Enter 计算 · 点结果复制" Foreground="#AAA" FontSize="11.5" Margin="14,7,14,8"/>
    </StackPanel>
  </Border>
</Window>
