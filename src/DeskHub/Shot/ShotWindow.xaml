<Window x:Class="DeskHub.Shot.ShotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="截图" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="Black" Cursor="Cross" UseLayoutRounding="False" SnapsToDevicePixels="False"
        FontFamily="{StaticResource UiFont}" FontSize="12" TextOptions.TextFormattingMode="Display">
  <Canvas x:Name="Root" ClipToBounds="True" Background="Transparent">
    <Image x:Name="Shot" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
    <Path x:Name="Mask" Fill="#80000000" IsHitTestVisible="False"/>
    <Canvas x:Name="Ink" IsHitTestVisible="False"/>
    <Rectangle x:Name="Frame" Stroke="#07C255" IsHitTestVisible="False" Visibility="Collapsed"/>
    <Canvas x:Name="Handles" IsHitTestVisible="False" Visibility="Collapsed"/>

    <!-- 尺寸和位置提示 -->
    <Border x:Name="SizeTip" Background="#D9000000" CornerRadius="2" Padding="7,3" IsHitTestVisible="False" Visibility="Collapsed">
      <TextBlock x:Name="SizeText" Foreground="White"/>
    </Border>

    <!-- 放大镜：看清像素、取颜色 -->
    <Border x:Name="Mag" Background="#E6000000" BorderBrush="White" BorderThickness="1" IsHitTestVisible="False" Visibility="Collapsed">
      <StackPanel>
        <Grid Width="125" Height="95">
          <Rectangle x:Name="MagView" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
          <Rectangle Width="125" Height="5" Fill="#5907C255" VerticalAlignment="Center"/>
          <Rectangle Width="5" Height="95" Fill="#5907C255" HorizontalAlignment="Center"/>
        </Grid>
        <TextBlock x:Name="MagPos" Foreground="White" Margin="6,3,6,0" FontSize="11.5"/>
        <TextBlock x:Name="MagRgb" Foreground="White" Margin="6,1,6,4" FontSize="11.5"/>
      </StackPanel>
    </Border>

    <!-- 工具条 -->
    <Border x:Name="Bar" Background="White" CornerRadius="4" Padding="4" Visibility="Collapsed" Cursor="Arrow">
      <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.3" RenderingBias="Performance"/></Border.Effect>
      <StackPanel x:Name="BarItems" Orientation="Horizontal"/>
    </Border>
    <Border x:Name="Sub" Background="White" CornerRadius="4" Padding="8,5" Visibility="Collapsed" Cursor="Arrow">
      <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.3" RenderingBias="Performance"/></Border.Effect>
      <StackPanel x:Name="SubItems" Orientation="Horizontal"/>
    </Border>
  </Canvas>
</Window>
