<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 带 Windows 版本号：截图的"提取文字"要用 Windows 自带的文字识别 -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>DeskHub</AssemblyName>
    <RootNamespace>DeskHub</RootNamespace>
    <StartupObject>DeskHub.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>HOTA DESK</Product>
    <AssemblyTitle>HOTA DESK</AssemblyTitle>
    <Company>HOTA</Company>
    <!-- 省内存：工作站 GC 非并发，空闲时更积极回收 -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- 托盘图标要用 WinForms，但不让它的同名类型（Point、Brush 等）混进 WPF 代码 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Resource Include="Assets\app.ico" />
    <!-- 界面多语言（中文原文 → 译文），打包进程序里 -->
    <EmbeddedResource Include="Lang\*.json" Exclude="Lang\_keys.json" />
    <!-- 给要接入密码箱接口的程序看的说明，跟程序放在一起 -->
    <None Include="密码箱接口说明.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- 内存紧时主动整理大对象堆（索引的大数组在里面） -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

</Project>
